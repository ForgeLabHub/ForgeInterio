# Interio — переменные окружения.
# Скопируйте в .env и заполните. Ни одно значение не имеет рабочего секрета в коде.

# --- Обязательные для админ-доступа -----------------------------------------
# Код для входа в админ-панель. Без него /api/auth/admin-login отвечает 503.
ADMIN_CODE=change-me-to-a-long-random-code

# --- Почта (опционально) ----------------------------------------------------
# Без SMTP_USERNAME и SMTP_PASSWORD письма не отправляются, приложение работает.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Прочее -----------------------------------------------------------------
# Путь к SQLite-базе (по умолчанию data.db)
DB_PATH=data.db
# Список разрешённых источников через запятую. Пусто = только тот же origin (same-origin).
CORS_ORIGINS=
# Фоновый keep-alive нужен только на бесплатном хостинге, который усыпляет приложение
KEEP_ALIVE_ENABLED=false
APP_URL=http://localhost:8000
ENV=development
